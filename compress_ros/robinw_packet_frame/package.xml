<?xml version="1.0"?>
<package format="3">
  <name>robinw_packet_frame</name>
  <version>0.1.0</version>
  <description>Assemble and losslessly compress Robin W packet frames.</description>
  <maintainer email="maintainer@localhost.invalid">Packet frame workspace</maintainer>
  <license>BSD-2-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <build_depend>pkg-config</build_depend>
  <depend>libzstd-dev</depend>
  <depend>libssl-dev</depend>
  <depend>seyond</depend>
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_sqlite3</exec_depend>
